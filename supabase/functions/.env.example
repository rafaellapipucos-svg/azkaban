# Copy to supabase/functions/.env (ignored by git) before `pnpm db:start`, which serves the functions and reads this file when it starts.
# A local demo value: the integration check in materialize-occurrences uses the same default.
# In production the secret is random, set with `supabase secrets set` and stored in the Vault.
CRON_SECRET=local-demo-cron-secret
