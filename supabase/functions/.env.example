# Copy to supabase/functions/.env (ignored by git) before `pnpm db:start`, which serves the functions and reads this file when it starts.
# A local demo value: the integration check in materialize-occurrences uses the same default.
# In production the secret is random, set with `supabase secrets set` and stored in the Vault.
CRON_SECRET=local-demo-cron-secret
# Web Push (ADR-0008, section 8). Names only: never commit a pair, not even a local one. Without them
# dispatch-notifications claims no push row (they wait) and still sends WhatsApp. docs/implantacao.md
# has the command that makes a pair; VAPID_PUBLIC_KEY must equal EXPO_PUBLIC_VAPID_PUBLIC_KEY of the app.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=
# WhatsApp (ADR-0009, section 12). Never commit a real token or secret. Empty or absent
# WHATSAPP_PROVIDER is `console`: no credentials, the log gets no phone and no text, and the message
# goes to whatsapp_console_messages, which only the service role reads. `meta` needs the other four.
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Local demo values, like CRON_SECRET, so the integration checks of whatsapp-webhook can sign a POST
# and answer the GET (whatsapp-webhook/webhook.integration.test.ts uses the same defaults). Never a
# real one here: in production both are random, set with `supabase secrets set`. Empty, the webhook
# answers 500 to the POST and 403 to the GET.
WHATSAPP_APP_SECRET=local-demo-whatsapp-app-secret
WHATSAPP_VERIFY_TOKEN=local-demo-whatsapp-verify-token
