# Copy to apps/app/.env.local (ignored by git). EXPO_PUBLIC_* values are bundled into the client: no secrets here.

EXPO_PUBLIC_APP_NAME=Azkaban
EXPO_PUBLIC_APP_SCHEME=azkaban
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>
# Optional: the public VAPID key of this environment (ADR-0008, section 8). Empty hides Web Push.
# The private key lives only in the Edge Function secrets.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=

# Optional: apps/app/.env.development.local overrides the two Supabase values under `pnpm dev`,
# pointing at the local stack. Use the values printed by `supabase status`.
