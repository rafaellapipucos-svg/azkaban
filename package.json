{
  "name": "azkaban",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @azkaban/app dev",
    "build:web": "pnpm --filter @azkaban/app build:web",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "typecheck": "turbo run typecheck",
    "db:test": "supabase test db",
    "functions:test": "node supabase/functions/_shared/wait-for-functions.mjs && node --test --test-concurrency=1 supabase/functions/materialize-occurrences/materialize.integration.test.ts supabase/functions/proof-validate/checks.test.ts supabase/functions/proof-validate/validate.integration.test.ts supabase/functions/proof-url/url.integration.test.ts supabase/functions/proof-retention/retention.integration.test.ts",
    "db:check-permissions": "node scripts/check-permission-mirror.mjs",
    "test": "turbo run test",
    "check": "pnpm lint && pnpm boundaries && pnpm typecheck && pnpm test",
    "e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migration": "supabase migration new",
    "db:types": "supabase gen types typescript --local > packages/data/src/database.types.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
